# Application
APP_NAME=Persian AI Data Analyst
APP_VERSION=0.1.0
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/persian_ai_db
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=persian_ai_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Ollama
# Set to false for lightweight mode.
# In lightweight mode the system uses semantic rules/templates and does not call Ollama.
LLM_ENABLED=true
OLLAMA_HOST=http://localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9

# Tenant
TENANT_ID=education_ministry

# Embedding
# Download the model separately; model weights are not stored in Git.
EMBEDDING_MODEL_PATH=./models/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cpu

# API
API_HOST=0.0.0.0
API_PORT=8080

      ]
    }
  ],
  "joins": [
    {"from_table": "employees", "from_column": "organization_unit_id", "to_table": "organization_units", "to_column": "id", "description": "هر کارمند به یک واحد سازمانی وصل است.", "cardinality": "many_to_one"},
    {"from_table": "schools", "from_column": "organization_unit_id", "to_table": "organization_units", "to_column": "id", "description": "هر مدرسه به یک واحد/منطقه سازمانی وصل است.", "cardinality": "many_to_one"},
    {"from_table": "students", "from_column": "school_id", "to_table": "schools", "to_column": "id", "description": "هر دانش‌آموز به یک مدرسه وصل است.", "cardinality": "many_to_one"},
    {"from_table": "salary_items", "from_column": "employee_id", "to_table": "employees", "to_column": "id", "description": "هر آیتم حقوقی مربوط به یک کارمند است.", "cardinality": "many_to_one"},
    {"from_table": "ranking_requests", "from_column": "employee_id", "to_table": "employees", "to_column": "id", "description": "هر درخواست رتبه‌بندی مربوط به یک کارمند است.", "cardinality": "many_to_one"},
    {"from_table": "retirement_records", "from_column": "employee_id", "to_table": "employees", "to_column": "id", "description": "هر سابقه بازنشستگی مربوط به یک کارمند است.", "cardinality": "many_to_one"}
  ],
  "rules": [
    {"name": "national_id_is_text", "description": "کد ملی در جدول‌های employees و students از نوع متنی است؛ حتی اگر فقط عدد باشد باید در SQL کوتیشن داشته باشد.", "applies_to": ["employees.national_id", "students.national_id"]},
    {"name": "student_province_join", "description": "برای فیلتر استان دانش‌آموز باید از مسیر students -> schools -> organization_units استفاده شود.", "applies_to": ["students", "schools", "organization_units"]},
    {"name": "school_province_join", "description": "برای مدرسه‌های یک استان باید schools به organization_units وصل شود، نه اینکه organization_units به‌تنهایی به‌عنوان مدرسه استفاده شود.", "applies_to": ["schools", "organization_units"]},
    {"name": "employee_province_join", "description": "برای کارمندان یک استان باید employees به organization_units وصل شود.", "applies_to": ["employees", "organization_units"]},
    {"name": "full_profile_columns", "description": "وقتی کاربر تمام ستون‌ها یا پروفایل کامل یک موجودیت را می‌خواهد، profile_columns همان جدول استفاده شود.", "applies_to": ["employees", "students", "schools"]}
  ]
}
